      article.main
        h1 Mixins
        p Mixins allow you to create reusable blocks of Pug.
        div.preview-wrapper(data-control="interactive" data-index="0")
          div.row(data-reactroot data-reactid="1" data-react-checksum="888256921")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  //- Declaration
                  mixin list
                    ul
                      li foo
                      li bar
                      li baz
                  //- Use
                  +list
                  +list
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <ul>
                    <li>foo</li>
                    <li>bar</li>
                    <li>baz</li>
                  </ul>
                  <ul>
                    <li>foo</li>
                    <li>bar</li>
                    <li>baz</li>
                  </ul>
        p Mixins are compiled to functions, and can take arguments:
        div.preview-wrapper(data-control="interactive" data-index="1")
          div.row(data-reactroot data-reactid="1" data-react-checksum="-971655497")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  mixin pet(name)
                    li.pet= name
                  ul
                    +pet('cat')
                    +pet('dog')
                    +pet('pig')
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <ul>
                    <li class="pet">cat</li>
                    <li class="pet">dog</li>
                    <li class="pet">pig</li>
                  </ul>
        h2#mixin-blocks
          | Mixin Blocks
          a.header-anchor(href="#mixin-blocks" aria-hidden="true") ¶
        p Mixins can also take a block of Pug to act as the content:
        div.preview-wrapper(data-control="interactive" data-index="2")
          div.row(data-reactroot data-reactid="1" data-react-checksum="-1111740153")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  mixin article(title)
                    .article
                      .article-wrapper
                        h1= title
                        if block
                          block
                        else
                          p No content provided
                  
                  +article('Hello world')
                  
                  +article('Hello world')
                    p This is my
                    p Amazing article
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <div class="article">
                    <div class="article-wrapper">
                      <h1>Hello world</h1>
                      <p>No content provided</p>
                    </div>
                  </div>
                  <div class="article">
                    <div class="article-wrapper">
                      <h1>Hello world</h1>
                      <p>This is my</p>
                      <p>Amazing article</p>
                    </div>
                  </div>
        h2#mixin-attributes
          | Mixin Attributes
          a.header-anchor(href="#mixin-attributes" aria-hidden="true") ¶
        p
          | Mixins also get an implicit
          code attributes
          | argument, which is taken from the attributes passed to the mixin:
        div.preview-wrapper(data-control="interactive" data-index="3")
          div.row(data-reactroot data-reactid="1" data-react-checksum="-1864322611")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  mixin link(href, name)
                    //- attributes == {class: "btn"}
                    a(class!=attributes.class href=href)= name
                  
                  +link('/foo', 'foo')(class="btn")
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <a class="btn" href="/foo">foo</a>
        div.alert.alert-info
          h6 Note
          p
            strong
              | The values in
              code attributes
              | by default are already escaped!
            | You should use
            code !=
            | to avoid escaping them a second time. (See also
            a(href="attributes.html#unescaped-attributes") unescaped attributes
            | .)
        p
          | You can also use mixins with
          a(href="attributes.html#attributes")
            code &attributes
          | :
        div.preview-wrapper(data-control="interactive" data-index="4")
          div.row(data-reactroot data-reactid="1" data-react-checksum="-227367882")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  mixin link(href, name)
                    a(href=href)&attributes(attributes)= name
                  
                  +link('/foo', 'foo')(class="btn")
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <a class="btn" href="/foo">foo</a>
        div.alert.alert-info
          h6 Note
          p
            | The syntax
            code +link(class="btn")
            | is also valid and equivalent to
            code +link()(class="btn")
            | , since Pug tries to detect if parentheses’ contents are attributes or arguments. Nevertheless, we encourage you to use the second syntax, as you pass explicitly no arguments and you ensure the first parenthesis is the arguments list.
        h2#default-arguments-values
          | Default Argument’s Values
          a.header-anchor(href="#default-arguments-values" aria-hidden="true") ¶
        p
          | You can also set default values for you
          code arguments
          | . Same as setting
          em default function parameters
          | in ES6.
        div.preview-wrapper(data-control="interactive" data-index="5")
          div.row(data-reactroot data-reactid="1" data-react-checksum="-966395967")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  //- Declaration
                  mixin article(title='Default Title')
                    .article
                      .article-wrapper
                        h1= title
                  
                  //- Use
                  +article()
                  
                  +article('Hello world')
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <div class="article">
                    <div class="article-wrapper">
                      <h1>Default Title</h1>
                    </div>
                  </div>
                  <div class="article">
                    <div class="article-wrapper">
                      <h1>Hello world</h1>
                    </div>
                  </div>
        h2#rest-arguments
          | Rest Arguments
          a.header-anchor(href="#rest-arguments" aria-hidden="true") ¶
        p You can write mixins that take an unknown number of arguments using the “rest arguments” syntax.
        div.preview-wrapper(data-control="interactive" data-index="6")
          div.row(data-reactroot data-reactid="1" data-react-checksum="369077732")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  mixin list(id, ...items)
                    ul(id=id)
                      each item in items
                        li= item
                  
                  +list('my-list', 1, 2, 3, 4)
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <ul id="my-list">
                    <li>1</li>
                    <li>2</li>
                    <li>3</li>
                    <li>4</li>
                  </ul>
        div(style="margin-top: 50px")
          div.AW-Form-692213006
