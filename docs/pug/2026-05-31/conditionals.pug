      article.main
        h1 Conditionals
        p Pug’s first-class conditional syntax allows for optional parentheses.
        p
          | If you’re coming from Pug v1, you may now omit the leading
          code -
          | . Otherwise, it’s identical (just regular JavaScript):
        div.preview-wrapper(data-control="interactive" data-index="0")
          div.row(data-reactroot data-reactid="1" data-react-checksum="1205472960")
            div.col-lg-6(data-reactid="2")
              div(data-reactid="3")
                textarea(data-reactid="4").
                  - var user = {description: 'foo bar baz'}
                  - var authorised = false
                  #user
                    if user.description
                      h2.green Description
                      p.description= user.description
                    else if authorised
                      h2.blue Description
                      p.description.
                        User has no description,
                        why not add one...
                    else
                      h2.red Description
                      p.description User has no description
            div.col-lg-6(data-reactid="5")
              div(data-reactid="6")
                textarea(readonly data-reactid="7").
                  <div id="user">
                    <h2 class="green">Description</h2>
                    <p class="description">foo bar baz</p>
                  </div>
        p
          | Pug also provides the conditional
          code unless
          | , which works like a negated
          code if
          | . The following are equivalent:
        div
          div.row
            div.col-lg-6
              pre.cm-s-default
                code
                  span.cm-keyword unless
                  span.cm-variable user
                  | .
                  span.cm-property isAnonymous
                  span.cm-indent
                  span.cm-tag p
                  span.cm-string You're logged in as #{user.name}
            div.col-lg-6
              pre.cm-s-default
                code
                  span.cm-keyword if
                  span.cm-operator !
                  span.cm-variable user
                  | .
                  span.cm-property isAnonymous
                  span.cm-indent
                  span.cm-tag p
                  span.cm-string You're logged in as #{user.name}
        div(style="margin-top: 50px")
