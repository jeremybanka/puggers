{
  "name": "puggers-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "build:npm": "pnpm --filter puggers build",
    "test:npm": "pnpm --filter puggers test",
    "test:lockfile": "node --test scripts/tests/pnpm-lockfile.test.ts",
    "npm-stage": "node ./scripts/npm-stage.node.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "comline": "0.9.1",
    "dprint-plugin-pug": "workspace:*",
    "puggers": "workspace:*",
    "takua": "0.2.3",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
