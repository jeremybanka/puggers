{
  "name": "puggers-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "just build",
    "build:npm": "pnpm --filter puggers build",
    "change": "knope document-change",
    "check": "pnpm run \"/^check:.*/\"",
    "check:cargo": "just check-cargo-workspace",
    "check:clippy": "just check-cargo-clippy",
    "check:fmt": "just fmt-cargo-check",
    "check:tsc": "tsc -p scripts/tsconfig.json && pnpm --filter puggers exec tsc",
    "check:versions": "node scripts/check-version-alignment.ts",
    "check:wasm": "just check-cargo-wasm",
    "fmt": "just fmt",
    "npm-stage": "node ./scripts/npm-stage.node.ts",
    "release:version": "knope version",
    "test": "just test",
    "test:npm": "pnpm --filter puggers test",
    "test:watch": "pnpm --filter puggers run test:watch"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "comline": "0.9.0",
    "dprint-plugin-pug": "workspace:*",
    "takua": "0.2.3",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}
