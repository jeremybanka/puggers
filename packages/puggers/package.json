{
  "name": "puggers",
  "version": "0.1.11",
  "description": "Native npm CLI and Node API for converting HTML to Pug.",
  "type": "module",
  "bin": {
    "puggers": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "install.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremybanka/puggers.git"
  },
  "keywords": [
    "html",
    "pug",
    "converter",
    "native"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "preferUnplugged": true,
  "scripts": {
    "build": "tsdown",
    "postinstall": "node ./install.js",
    "test": "node --test test/*.test.ts",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "optionalDependencies": {
    "@puggers/darwin-arm64": "workspace:*",
    "@puggers/darwin-x64": "workspace:*",
    "@puggers/linux-arm64-glibc": "workspace:*",
    "@puggers/linux-x64-glibc": "workspace:*",
    "@puggers/win32-arm64": "workspace:*",
    "@puggers/win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}